---
import Navegation from "../pages/components/Navegation.astro";
import Footer from "../pages/components/Footer.astro";

// Mantén este valor igual al de Postulaciones.astro
const postulacionesAbiertas = false;
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/images/logo rm.png" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;500;800&display=swap" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Postulaciones - Jupechi RM</title>
</head>
<body>
    <Navegation />

    <div class="espaciador-nav"></div>

    <main class="form-section">
        <div class="container">
            <div class="titulo-seccion">
                <h1>Únete al <span class="highlight">Equipo</span></h1>
                {postulacionesAbiertas ? (
                    <p>Completa el formulario a continuación para ser parte de lo que Dios está haciendo en la Región Metropolitana.</p>
                ) : (
                    <p>Todavía no se abre un nuevo proceso de postulación.</p>
                )}
            </div>

            {postulacionesAbiertas ? (
                <div class="iframe-card">
                    <div class="glow-effect"></div>

                    <iframe
                        src="https://forms.gle/yDQgA8bjXGPaPkcc7?embedded=true"
                        width="100%"
                        height="900"
                        frameborder="0"
                        marginheight="0"
                        marginwidth="0"
                        class="formulario-google">
                        Cargando formulario...
                    </iframe>

                </div>
            ) : (
                <div class="cerrado-card">
                    <p class="icono-cerrado">📋</p>
                    <h2>No hay postulaciones abiertas</h2>
                    <p>Por el momento no tenemos un proceso de postulación en curso. Síguenos en nuestras redes para enterarte apenas se abra un nuevo ciclo.</p>
                    <a href="https://www.instagram.com/jupechi_rm/" target="_blank" class="btn-volver">Síguenos en Instagram</a>
                </div>
            )}
            
            <div class="volver">
                <a href="/" class="btn-volver">← Volver al Inicio</a>
            </div>
        </div>
    </main>

    <Footer />
</body>
</html>

<style>
    /* ESPACIADOR PARA EL HEADER FIJO */
    .espaciador-nav {
        height: 80px; 
    }

    .form-section {
        padding: 4rem 1rem;
        min-height: 100vh;
        display: flex;
        align-items: center;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
        width: 100%;
    }

    .titulo-seccion {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    h1 {
        font-size: 3.5rem;
        color: white !important;
        margin: 0 0 0.5rem 0;
        line-height: 1.1;
    }

    .highlight {
        color: #4fb3e8 !important;
        text-shadow: 0 0 20px rgba(79, 179, 232, 0.5);
    }

    p {
        font-size: 1.1rem;
        color: #cbd5e1;
    }

    /* TARJETA DEL FORMULARIO */
    .iframe-card {
        background-color: #0a1929;
        border: 1px solid #4fb3e8;
        border-radius: 16px;
        padding: 10px; /* Un poco de padding para que respire */
        position: relative;
        overflow: hidden;
        box-shadow: 0 0 30px rgba(79, 179, 232, 0.15);
    }

    .glow-effect {
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(79, 179, 232, 0.05) 0%, transparent 70%);
        pointer-events: none;
    }

    .formulario-google {
        position: relative;
        z-index: 2;
        border-radius: 8px;
        background-color: transparent;
    }

    /* TARJETA DE ESTADO CERRADO */
    .cerrado-card {
        background-color: #0a1929;
        border: 1px solid #3f3f46;
        border-radius: 16px;
        padding: 3rem 2rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .icono-cerrado {
        font-size: 3rem;
        margin: 0;
    }

    .cerrado-card h2 {
        font-size: 1.8rem;
        color: #ffffff !important;
        margin: 0;
    }

    .cerrado-card p {
        max-width: 500px;
        color: #cbd5e1;
    }

    .cerrado-card .btn-volver {
        border: 1px solid #4fb3e8;
        margin-top: 0.5rem;
    }

    /* BOTÓN VOLVER */
    .volver {
        text-align: center;
        margin-top: 3rem;
    }

    .btn-volver {
        color: #94a3b8;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        padding: 10px 20px;
        border-radius: 50px;
        border: 1px solid transparent;
    }

    @media (hover: hover) and (pointer: fine) {
        .btn-volver:hover {
            color: #4fb3e8;
            border-color: #4fb3e8;
            background-color: rgba(79, 179, 232, 0.1);
        }
    }

    .btn-volver:active {
        color: #4fb3e8;
        border-color: #4fb3e8;
        background-color: rgba(79, 179, 232, 0.1);
    }

    @media (max-width: 768px) {
        h1 { font-size: 2.5rem; }
        .iframe-card { padding: 0; border-radius: 12px; }
        .formulario-google { height: 1100px; /* Los forms en celular suelen ser más largos */ }
    }
</style>

<style is:global>
  /* Traemos TODOS los estilos globales exactos del index */
  :root {
    --fondo-principal: #0d1826; 
    --texto-principal: #b8cbe0; 
    --color-titulos: #4fb3e8;   
    --acento: #a855f7;
  }

  html {
    font-family: 'Outfit', system-ui, sans-serif;
    background-color: var(--fondo-principal);
    color: var(--texto-principal);
    scroll-behavior: smooth;
  }

  body { margin: 0; padding: 0; }

  /* Títulos */
  h1, h2, h3, h4, h5, h6 {
    color: var(--color-titulos) !important;
    letter-spacing: -0.5px;
    font-weight: 700;
  }

  /* Textos */
  p, li, span, div {
    color: var(--texto-principal);
    line-height: 1.6;
  }

  /* Enlaces (ESTO ARREGLA EL PROBLEMA MORADO) */
  a {
    color: #e4e4e7;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      color: var(--color-titulos);
      text-shadow: 0 0 10px rgba(79, 179, 232, 0.5);
    }
  }

  a:active {
    color: var(--color-titulos);
  }

  /* Reset Botones */
  button, .btn { color: #ffffff !important; }
</style>