---
/* Eventos.astro */
---
<section id="eventos">
    <div class="container">
        
        <div class="titulo-seccion">
            <h2>Próximos Eventos</h2>
            <p>Agenda Regional</p>
        </div>

        <div class="timeline">
            
            <div class="evento-card">
                <div class="fecha-box">
                    <span class="dia">06</span>
                    <span class="mes">JUN</span>
                </div>
                
                <div class="info-evento">
                    <h3>Masivo Regional</h3>
                    <div class="detalles">
                        <span class="dato">
                            <span class="icono">📍</span> Iglesia de Maipú
                        </span>
                        <span class="dato">
                            <span class="icono">⏰</span> 18:00 hrs
                        </span>
                    </div>
                </div>

                <div class="action">
                    <span class="btn-ver">Ver Info &rarr;</span>
                </div>
            </div>

            <div class="evento-card destacado">
                <div class="fecha-box">
                    <span class="dia">17</span>
                    <span class="mes">OCT</span>
                </div>

                <a href="/images/eventos/ojos-que-ven-afiche.jpg" target="_blank" class="afiche-thumb">
                    <img src="/images/eventos/ojos-que-ven-afiche.jpg" alt="Afiche Ojos que ven - Masivo Regional Juvenil" />
                </a>

                <div class="info-evento">
                    <span class="badge-destacado">Próximo Masivo</span>
                    <h3>Ojos que ven</h3>
                    <div class="detalles">
                        <span class="dato">
                            <span class="icono">📍</span> Ipechi Santa Ana
                        </span>
                        <span class="dato">
                            <span class="icono">⏰</span> 18:00 hrs
                        </span>
                    </div>
                </div>
                <div class="action">
                    <span class="btn-ver">Ver Info &rarr;</span>
                </div>

            </div>
            <div class="evento-card">
                <div class="fecha-box">
                    <span class="dia">05</span>
                    <span class="mes">DIC</span>
                </div>
                
                <div class="info-evento">
                    <h3>Votación Regional</h3>
                    <div class="detalles">
                        <span class="dato">
                            <span class="icono">📍</span> Iglesia de Cerro Navia
                        </span>
                        <span class="dato">
                            <span class="icono">⏰</span> 18:00 hrs
                        </span>
                    </div>
                </div>    

                <div class="action">
                    <span class="btn-ver">Ver Info &rarr;</span>
                </div>
            </div>

            <div class="evento-card">
                <div class="fecha-box">
                    <span class="dia">16-17</span>
                    <span class="mes">ENE</span>
                </div>
                
                <div class="info-evento">
                    <h3>Campamento Regional</h3>
                    <div class="detalles">
                        <span class="dato">
                            <span class="icono">📍</span> Por definir
                        </span>
                        <span class="dato">
                            <span class="icono">⛺</span> 10:00 hrs
                        </span>
                    </div>
                </div>    

                <div class="action">
                    <span class="btn-ver">Ver Info &rarr;</span>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    /* SECCIÓN */
    #eventos {
        padding: 6rem 1rem;
        background-color: transparent; /* Transparente para ver el fondo global */
    }

    .container {
        max-width: 900px; 
        margin: 0 auto;
    }

    /* TÍTULOS */
    .titulo-seccion {
        text-align: center;
        margin-bottom: 3rem;
    }

    h2 { 
        font-size: 3rem; 
        color: #4fb3e8 !important; /* Cyan Brillante */
        font-weight: 800;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        text-shadow: 0 0 20px rgba(79, 179, 232, 0.3);
    }

    .titulo-seccion p {
        color: #b8cbe0;
        font-size: 1.2rem;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    /* TIMELINE */
    .timeline { 
        display: flex; 
        flex-direction: column; 
        gap: 1.5rem; 
    }

    /* TARJETA DE EVENTO */
    .evento-card {
        display: flex;
        align-items: center;
        background-color: #152a3d; 
        border: 1px solid #2c5f82; 
        border-radius: 16px;
        padding: 1.5rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .evento-card.destacado {
        border: 2px solid #4fb3e8;
        box-shadow: 0 0 30px rgba(79, 179, 232, 0.25);
        background: linear-gradient(135deg, #152a3d, #0d1826);
    }

    .afiche-thumb {
        flex-shrink: 0;
        width: 70px;
        height: 88px;
        border-radius: 8px;
        overflow: hidden;
        margin-right: 1.5rem;
        border: 1px solid rgba(79, 179, 232, 0.4);
        display: block;
    }

    .afiche-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
    }

    @media (hover: hover) and (pointer: fine) {
        .afiche-thumb:hover img {
            transform: scale(1.08);
        }
    }

    .badge-destacado {
        display: inline-block;
        background-color: rgba(79, 179, 232, 0.15);
        color: #4fb3e8;
        border: 1px solid #4fb3e8;
        padding: 0.2rem 0.8rem;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.4rem;
    }

    /* Efecto Hover */
    @media (hover: hover) and (pointer: fine) {
        .evento-card:hover {
            transform: translateX(10px); 
            border-color: #4fb3e8; 
            box-shadow: 0 4px 20px rgba(44, 95, 130, 0.2);
            background-color: #202024; 
        }
    }

    /* CAJA DE FECHA */
    .fecha-box {
        background: linear-gradient(135deg, #2c5f82, #4fb3e8);
        padding: 1rem;
        border-radius: 12px;
        text-align: center;
        min-width: 80px;
        margin-right: 1.5rem;
        box-shadow: 0 0 15px rgba(79, 179, 232, 0.4); 
        color: #0a1929; 
    }

    .dia { 
        display: block; 
        font-size: 2rem; 
        font-weight: 800; 
        line-height: 1;
        color: #ffffff !important;
    }
    
    .mes { 
        display: block; 
        font-size: 0.85rem; 
        font-weight: 700; 
        text-transform: uppercase;
        margin-top: 2px;
        color: #ffffff !important;
    }

    /* INFORMACIÓN DEL EVENTO */
    .info-evento {
        flex-grow: 1;
    }

    .info-evento h3 { 
        margin: 0 0 0.5rem 0; 
        font-size: 1.5rem; 
        color: #ffffff !important;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .detalles {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .dato {
        color: #d4d4d8; /* Gris claro */
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .icono {
        filter: drop-shadow(0 0 5px rgba(255,255,255,0.5));
    }

    /* BOTÓN/ACCIÓN */
    .action {
        margin-left: 1rem;
        opacity: 0; /* Invisible al principio */
        transform: translateX(-10px);
        transition: all 0.3s ease;
    }

    .btn-ver {
        color: #4fb3e8;
        font-weight: 600;
        font-size: 0.9rem;
        text-transform: uppercase;
    }

    @media (hover: hover) and (pointer: fine) {
        .evento-card:hover .action {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* RESPONSIVE (Celulares) */
    @media (max-width: 600px) {
        .evento-card { 
            flex-direction: column;
            text-align: center; 
            padding: 2rem 1.5rem;
            gap: 1rem;
        }
        
        .fecha-box { 
            margin-right: 0; 
            min-width: 100px;
        }

        .afiche-thumb {
            width: 110px;
            height: 138px;
            margin-right: 0;
        }

        .detalles {
            justify-content: center;
            gap: 0.8rem;
            flex-direction: column;
        }

        .action {
            opacity: 1;
            transform: none;
            margin-top: 1rem;
            margin-left: 0;
        }
    }
</style>