---
/* Departamentos.astro */
---
<section id="departamentos">
  <div class="container">
    
    <div class="titulo-seccion">
      <h2>Nuestros Departamentos</h2>
      <p>Equipos unidos para servir con excelencia.</p>
    </div>

    <div class="grid-deptos">

      <div class="depto-card">
        <img src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&q=80" alt="Comunicaciones" class="fondo-img">
        <div class="content">
          <div class="icono-badge"><span class="icono">📸</span></div>
          <h3>Comunicaciones</h3>
          <p class="desc">Difusión del Evangelio y RRSS</p>
          
          <div class="liderazgo">
             <div class="lider-row"><span class="lider-rol">Directora</span><span class="lider-nombre">Antonia Vicencio</span></div>
             <div class="lider-row"><span class="lider-rol">Subdirector</span><span class="lider-nombre">Alonso Pavez</span></div>
          </div>
        </div>
      </div>

      <div class="depto-card">
        <img src="/images/deptos/danza.jpg" alt="Danza" class="fondo-img">
        <div class="content">
          <div class="icono-badge"><span class="icono">✨</span></div>
          <h3>Danza</h3>
          <p class="desc">Adoración a Dios a través de la danza</p>
          
          <div class="liderazgo">
             <div class="lider-row"><span class="lider-rol">Directora</span><span class="lider-nombre">Graciela Herrera</span></div>
             <div class="lider-row"><span class="lider-rol">Subdirectora</span><span class="lider-nombre">Camila Torres</span></div>
          </div>
        </div>
      </div>

      <div class="depto-card">
        <img src="/images/deptos/protocolo.jpg" alt="Protocolo" class="fondo-img">
        <div class="content">
          <div class="icono-badge"><span class="icono">👔</span></div>
          <h3>Protocolo</h3>
          <p class="desc">Recepción, orden y excelencia</p>
          
          <div class="liderazgo">
             <div class="lider-row"><span class="lider-rol">Directora</span><span class="lider-nombre">Paz López</span></div>
             <div class="lider-row"><span class="lider-rol">Subdirector</span><span class="lider-nombre">Matías Espinoza</span></div>
          </div>
        </div>
      </div>


      <div class="depto-card">
        <img src="/images/deptos/capaz.jpg" alt="Capacitación" class="fondo-img">
        <div class="content">
          <div class="icono-badge"><span class="icono">📖</span></div>
          <h3>Capacitación</h3>
          <p class="desc">Fundamento bíblico y enseñanza</p>
          
          <div class="liderazgo">
             <div class="lider-row"><span class="lider-rol">Director</span><span class="lider-nombre">Nicolás Castro</span></div>
             <div class="lider-row"><span class="lider-rol">Subdirector</span><span class="lider-nombre">Boris Jofré</span></div>
          </div>
        </div>
      </div>

      <div class="depto-card">
        <img src="/images/deptos/conjunto.jpg" alt="Conjunto" class="fondo-img">
        <div class="content">
          <div class="icono-badge"><span class="icono">🎵</span></div>
          <h3>Conjunto Musical</h3>
          <p class="desc">Guiando en alabanza y adoración</p>
          
          <div class="liderazgo">
             <div class="lider-row"><span class="lider-rol">Director</span><span class="lider-nombre">Juan Carlos Sarmiento</span></div>
             <div class="lider-row"><span class="lider-rol">Subdirector</span><span class="lider-nombre">Samuel Aros</span></div>
          </div>
        </div>
      </div>

      <div class="depto-card">
        <img src="/images/deptos/evangelismo.jpg" alt="Evangelismo" class="fondo-img">
        <div class="content">
          <div class="icono-badge"><span class="icono">🔥</span></div>
          <h3>Evangelismo</h3>
          <p class="desc">Llevando el mensaje de salvación</p>
          
          <div class="liderazgo">
             <div class="lider-row"><span class="lider-rol">Directora</span><span class="lider-nombre">Yesenia Gajardo</span></div>
             <div class="lider-row"><span class="lider-rol">Subdirector</span><span class="lider-nombre">Raúl Rojas</span></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ESTILOS BASE */
  section { padding: 4rem 1rem; background-color: transparent; }
  .container { max-width: 1200px; margin: 0 auto; }
  
  .titulo-seccion { text-align: center; margin-bottom: 3rem; }
  .titulo-seccion h2 { font-size: 3rem; font-weight: 800; margin-bottom: 0.5rem; text-transform: uppercase; color: #4fb3e8 !important; text-shadow: 0 0 20px rgba(79, 179, 232, 0.3); }
  .titulo-seccion p { color: #b8cbe0; font-size: 1.1rem; }

  /* GRILLA */
  .grid-deptos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    justify-content: center;
  }

  /* TARJETA BASE */
  .depto-card {
    position: relative;
    height: 380px; 
    border-radius: 16px;
    overflow: hidden; 
    background-color: #152a3d; 
    border: 1px solid #2c5f82;
    box-shadow: 0 4px 20px rgba(44, 95, 130, 0.15);
    transition: all 0.4s ease;
  }

  .depto-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 3;
    background: linear-gradient(90deg, transparent, #4fb3e8, #a855f7, transparent);
  }

  .fondo-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    filter: brightness(0.6);
    transition: transform 0.5s ease, filter 0.5s ease;
  }

  /* HOVER PC */
  @media (hover: hover) and (pointer: fine) {
    .depto-card:hover { transform: translateY(-5px); border-color: #4fb3e8; box-shadow: 0 0 25px rgba(79, 179, 232, 0.4); }
    .depto-card:hover .fondo-img { transform: scale(1.05); filter: brightness(0.4); }
  }

  /* CONTENIDO */
  .content {
    position: absolute;
    bottom: 0; left: 0; width: 100%;
    box-sizing: border-box;
    padding: 1.5rem;
    z-index: 2;
    display: flex; flex-direction: column; gap: 0.5rem;
    background: linear-gradient(to top, rgba(10, 25, 41, 0.95) 20%, transparent 100%);
    overflow: hidden;
  }

  .icono-badge {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(79, 179, 232, 0.12);
    border: 1px solid rgba(79, 179, 232, 0.4);
    backdrop-filter: blur(4px);
    margin-bottom: 0.3rem;
  }

  .icono { font-size: 1.7rem; filter: drop-shadow(0 0 8px rgba(79, 179, 232, 0.6)); }
  h3 { font-size: 1.6rem; font-weight: 700; color: #4fb3e8 !important; margin: 0; text-transform: uppercase; letter-spacing: 0.5px; overflow-wrap: break-word; }
  
  /* ESTILO DE LA DESCRIPCIÓN ORIGINAL */
  p.desc { font-size: 0.95rem; color: #e4e4e7; margin: 0; overflow-wrap: break-word; }

  /* --- ESTILOS PARA EL LIDERAZGO --- */
  .liderazgo {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.12); 
    display: flex;
    flex-direction: column;
    gap: 6px; 
  }

  .lider-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .lider-rol {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #4fb3e8;
    background-color: rgba(79, 179, 232, 0.1);
    border: 1px solid rgba(79, 179, 232, 0.3);
    padding: 2px 8px;
    border-radius: 50px;
  }

  .lider-nombre {
    font-size: 0.9rem;
    color: #e4e4e7;
    font-weight: 500;
  }

  @media (max-width: 768px) {

    .titulo-seccion h2 {
        font-size: 2.5rem !important;
        line-height: 1.1;
        word-wrap: break-word; 
    }
    
    .grid-deptos {
        grid-template-columns: 1fr !important;
        padding: 0 10px;
        gap: 1.5rem;
    }

    .depto-card {
        height: auto !important;
        display: flex;
        flex-direction: column;
    }

    .fondo-img {
        position: static !important;
        width: 100% !important;
        height: 190px !important;
        object-fit: cover !important;
        object-position: center !important;
        filter: brightness(0.75) !important;
    }

    /* CONTENIDO */
    .content {
        position: static !important;
        margin-top: 0 !important;
        padding: 1rem !important;
        background: #152a3d !important;
    }

    h3 { font-size: 1.4rem; }
    p.desc { font-size: 0.9rem; }
  }
</style>