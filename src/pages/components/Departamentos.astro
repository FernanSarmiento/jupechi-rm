---
/* Departamentos.astro */
---
<section id="departamentos">
  <div class="container">
    
    <div class="titulo-seccion">
      <h2>Nuestros Departamentos</h2>
      <p>Equipos unidos para servir con excelencia.</p>
    </div>

    <div class="grid-deptos">

      <div class="depto-card">
        <img src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&q=80" alt="Comunicaciones" class="fondo-img">
        <div class="content">
          <div class="icono">📸</div>
          <h3>Comunicaciones</h3>
          <p class="desc">Difusión del Evangelio y RRSS</p>
          
          <div class="liderazgo">
             <p><strong>Director:</strong> Director</p>
             <p><strong>Subdirector:</strong> Subdirector</p>
          </div>
        </div>
      </div>

      <div class="depto-card">
        <img src="/images/deptos/danza.jpg" alt="Danza" class="fondo-img">
        <div class="content">
          <div class="icono">💃</div>
          <h3>Danza</h3>
          <p class="desc">Adoración a Dios a través de la danza</p>
          
          <div class="liderazgo">
             <p><strong>Director:</strong> Director</p>
             <p><strong>Subdirector:</strong> Subdirector</p>
          </div>
        </div>
      </div>

      <div class="depto-card">
        <img src="/images/deptos/protocolo.jpg" alt="Protocolo" class="fondo-img">
        <div class="content">
          <div class="icono">👔</div>
          <h3>Protocolo</h3>
          <p class="desc">Recepción, orden y excelencia</p>
          
          <div class="liderazgo">
             <p><strong>Director:</strong> Director</p>
             <p><strong>Subdirector:</strong> Subdirector</p>
          </div>
        </div>
      </div>


      <div class="depto-card">
        <img src="/images/deptos/capaz.jpg" alt="Capacitación" class="fondo-img">
        <div class="content">
          <div class="icono">📖</div>
          <h3>Capacitación</h3>
          <p class="desc">Fundamento bíblico y enseñanza</p>
          
          <div class="liderazgo">
             <p><strong>Director:</strong> Director</p>
             <p><strong>Subdirector:</strong> Subdirector</p>
          </div>
        </div>
      </div>

      <div class="depto-card">
        <img src="/images/deptos/conjunto.jpg" alt="Conjunto" class="fondo-img">
        <div class="content">
          <div class="icono">🎵</div>
          <h3>Conjunto Musical</h3>
          <p class="desc">Guiando en alabanza y adoración</p>
          
          <div class="liderazgo">
             <p><strong>Director:</strong> Director</p>
             <p><strong>Subdirector:</strong> Subdirector</p>
          </div>
        </div>
      </div>

      <div class="depto-card">
        <img src="/images/deptos/evangelismo.jpg" alt="Evangelismo" class="fondo-img">
        <div class="content">
          <div class="icono">🔥</div>
          <h3>Evangelismo</h3>
          <p class="desc">Llevando el mensaje de salvación</p>
          
          <div class="liderazgo">
             <p><strong>Director:</strong> Director</p>
             <p><strong>Subdirector:</strong> Subdirector</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ESTILOS BASE */
  section { padding: 4rem 1rem; background-color: transparent; }
  .container { max-width: 1200px; margin: 0 auto; }
  
  .titulo-seccion { text-align: center; margin-bottom: 3rem; }
  .titulo-seccion h2 { font-size: 3rem; font-weight: 800; margin-bottom: 0.5rem; text-transform: uppercase; color: #22d3ee !important; text-shadow: 0 0 20px rgba(34, 211, 238, 0.3); }
  .titulo-seccion p { color: #a1a1aa; font-size: 1.1rem; }

  /* GRILLA */
  .grid-deptos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    justify-content: center;
  }

  /* TARJETA BASE */
  .depto-card {
    position: relative;
    height: 360px; 
    border-radius: 16px;
    overflow: hidden; 
    background-color: #0f172a; 
    border: 1px solid #008C9E;
    box-shadow: 0 4px 20px rgba(0, 140, 158, 0.15);
    transition: all 0.4s ease;
  }

  .fondo-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    filter: brightness(0.6);
    transition: transform 0.5s ease, filter 0.5s ease;
  }

  /* HOVER PC */
  .depto-card:hover { transform: translateY(-5px); border-color: #22d3ee; box-shadow: 0 0 25px rgba(34, 211, 238, 0.4); }
  .depto-card:hover .fondo-img { transform: scale(1.05); filter: brightness(0.4); }

  /* CONTENIDO */
  .content {
    position: absolute;
    bottom: 0; left: 0; width: 100%;
    padding: 1.5rem;
    z-index: 2;
    display: flex; flex-direction: column; gap: 0.5rem;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.95) 20%, transparent 100%);
  }

  .icono { font-size: 2.5rem; margin-bottom: 0.5rem; filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.6)); }
  h3 { font-size: 1.6rem; font-weight: 700; color: #22d3ee !important; margin: 0; text-transform: uppercase; }
  
  /* ESTILO DE LA DESCRIPCIÓN ORIGINAL */
  p.desc { font-size: 0.95rem; color: #e4e4e7; margin: 0; }

  /* --- ESTILOS PARA EL LIDERAZGO --- */
  .liderazgo {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.2); 
    display: flex;
    flex-direction: column;
    gap: 4px; 
  }

  .liderazgo p {
    font-size: 0.85rem; 
    color: #e4e4e7;
    margin: 0;
  }

  .liderazgo strong {
    color: #22d3ee; 
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  @media (max-width: 768px) {

    .titulo-seccion h2 {
        font-size: 2.5rem !important;
        line-height: 1.1;
        word-wrap: break-word; 
    }
    
    .grid-deptos {
        grid-template-columns: 1fr !important;
        padding: 0 10px;
        gap: 1.5rem;
    }

    .depto-card {
        height: auto !important; 
        min-height: 320px;
    }

    .fondo-img {
        height: auto !important; 
        width: 100% !important;
        top: 0 !important;
        object-fit: contain !important;
        object-position: top center !important;
        filter: brightness(0.9) !important;
    }

    /* CONTENIDO */
    .content {
        padding: 1rem !important;
        background: linear-gradient(to top, #0f172a 40%, transparent 100%) !important;
        position: relative;
        margin-top: 50%; 
    }

    h3 { font-size: 1.4rem; }
    p.desc { font-size: 0.9rem; }
  }
</style>