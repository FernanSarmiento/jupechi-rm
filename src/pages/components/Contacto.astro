---
/* Contacto.astro */
---
<section id="contacto">
  <div class="contenedor-contacto">
    
    <div class="titulo-seccion">
        <h2>Contáctanos</h2>
        <p></p>
    </div>

    <div class="datos-grid">
      
      <div class="dato-item whatsapp-card">
        <div class="icon-glow">📱</div>
        <h3>WhatsApp</h3>
        <p>+56 9 6248 0887</p>
        <a href="https://wa.me/56962480887" target="_blank" class="btn-tech whatsapp">
          Hablar Ahora &rarr;
        </a>
      </div>

      <div class="dato-item correo-card">
        <div class="icon-glow">✉️</div>
        <h3>Correo</h3>
        <p>rm.jupechi@gmail.com</p>
        <a href="mailto:rm.jupechi@gmail.com" class="btn-tech correo">
          Enviar Mensaje &rarr;
        </a>
      </div>

    </div>

  </div>
</section>

<style>
  /* SECCIÓN */
  #contacto {
    padding: 6rem 1rem;
    background-color: transparent; 
    text-align: center;
  }

  .contenedor-contacto {
    max-width: 900px;
    margin: 0 auto;
  }

  /* 2. TÍTULOS */
  .titulo-seccion {
    margin-bottom: 4rem;
  }

  h2 {
    font-size: 3rem;
    color: #4fb3e8 !important; /* Cyan Brillante */
    font-weight: 800;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    text-shadow: 0 0 20px rgba(79, 179, 232, 0.3);
  }

  .titulo-seccion p {
    color: #b8cbe0;
    font-size: 1.2rem;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  /* GRILLA */
  .datos-grid {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  /* TARJETAS */
  .dato-item {
    background: #152a3d;
    padding: 3rem 2rem;
    border-radius: 20px;
    flex: 1;
    min-width: 280px;
    max-width: 400px;
    
    border: 1px solid #2c5f82; /* Borde Cyan base */
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .dato-item:hover {
      transform: translateY(-8px);
      border-color: #4fb3e8;
      box-shadow: 0 0 30px rgba(79, 179, 232, 0.2);
    }

    .dato-item:hover .icon-glow {
      transform: scale(1.1); /* El icono crece un poco */
    }
  }

  /* ICONOS */
  .icon-glow {
    font-size: 3.5rem;
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.3));
    transition: transform 0.3s ease;
  }

  h3 {
    font-size: 1.5rem;
    color: #ffffff !important;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    font-weight: 700;
  }

  p {
    font-size: 1.1rem;
    color: #d1d5db; /* Gris claro */
    margin-bottom: 2rem;
  }

  /* BOTONES TECH */
  .btn-tech {
    display: inline-block;
    padding: 12px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    letter-spacing: 1px;
  }

  /* Estilo WhatsApp */
  .whatsapp {
    background-color: transparent;
    border: 2px solid #25D366;
    color: #25D366;
  }

  @media (hover: hover) and (pointer: fine) {
    .whatsapp:hover {
      background-color: #25D366;
      color: #052e16; /* Texto oscuro para contraste */
      box-shadow: 0 0 20px rgba(37, 211, 102, 0.5); /* Glow Verde */
    }
  }

  .whatsapp:active {
    background-color: #25D366;
    color: #052e16;
  }

  /* Estilo Correo */
  .correo {
    background-color: transparent;
    border: 2px solid #4fb3e8;
    color: #4fb3e8;
  }

  @media (hover: hover) and (pointer: fine) {
    .correo:hover {
      background-color: #4fb3e8;
      color: #0a1929; /* Texto oscuro */
      box-shadow: 0 0 20px rgba(79, 179, 232, 0.5); /* Glow Cyan */
    }
  }

  .correo:active {
    background-color: #4fb3e8;
    color: #0a1929;
  }

  /* RESPONSIVE */
  @media (max-width: 600px) {
    .datos-grid {
      flex-direction: column;
      align-items: center;
    }
    
    .dato-item {
        width: 100%; 
        box-sizing: border-box;
    }
  }
</style>